# =============================================================================
# BIFM UT POC — environment configuration
# =============================================================================
# Copy this file to `.env` (already done for you if you're reading this from
# a freshly unzipped copy of the app — see .env in the project root) and
# fill in the keys for whichever OCR/LLM provider and connectors you're
# using. `.env` is loaded automatically on startup (config/settings.py) and
# is gitignored, so you only ever enter these once — no more re-exporting
# environment variables every session.
#
# Only fill in the section(s) you actually need:
#   - GEMINI_API_KEY is required — it's the app's only LLM backend.
#   - SharePoint and IMAP are both optional intake connectors — leave
#     either section blank to keep that source disabled in the UI.
# =============================================================================


# --- Google Gemini (the LLM backend) --------------------------------------------
# Talks to Google directly - get a key at https://aistudio.google.com/apikey
# (any Google account, no card required). Replaced OpenRouter as the
# backend after a real batch run found OpenRouter's free-tier shared pool
# throwing 429s from OTHER OpenRouter users' contention, not this
# account's own quota — see app/llm/gemini_client.py's docstring for the
# full story.
GEMINI_API_KEY=
# gemini-3.1-flash-lite - verified as a current "Stable", multimodal
# model on Google's own model list (ai.google.dev/gemini-api/docs/models)
# before picking it, not guessed.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT=60
GEMINI_MAX_RETRIES=3
GEMINI_NUM_PREDICT=800


# --- OCR tuning (optional) ----------------------------------------------------
# Straighten tilted scans before reading them (pure local math, ~100ms/page).
OCR_DESKEW=true
# One focused re-read when a document's mandatory fields come back blank -
# at most one extra vision call per document, only on documents that would
# otherwise auto-reject.
RETRY_MISSING_MANDATORY=true


# --- SharePoint intake/filing connector (optional) ---------------------------
# Microsoft Graph API app registration (client-credentials / app-only auth).
# One tenant/app/site shared by BOTH use cases - leave blank to disable
# SharePoint as a source for either. See README.md's "SharePoint Folder
# Structure" sections for the exact folders to create on the real site
# before pointing these at it.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# UT (Use Case 1) - Section 3's Submission -> Captured -> Approved/Rejected input.
SHAREPOINT_SUBMISSION_FOLDER=UT Instructions/Submissions
# Set to true to also push filed UT documents back to SharePoint (in
# addition to the local filing simulation), mirroring the exact Section 6
# per-form-type tree app/services/filer.py builds locally.
SHAREPOINT_WRITE_BACK=false

# Ops (Use Case 2) - input folder for incoming Withdrawal/Contribution
# documents (PDF, and exported .eml/.txt - unlike UT's PDF-only folder).
SHAREPOINT_OPS_SUBMISSION_FOLDER=Ops Instructions/Submissions
# Where a submission-folder item is MOVED (not deleted) once downloaded, so
# a repeat run/poll doesn't re-process it into a duplicate transaction -
# the SharePoint-side equivalent of IMAP marking a message \Seen.
SHAREPOINT_OPS_PROCESSED_FOLDER=Ops Instructions/Submissions/Processed
# Set to false to leave items in the submission folder after download
# instead (e.g. while repeatedly testing against the same file).
SHAREPOINT_OPS_MARK_PROCESSED=true
# SharePoint roots filed documents / compiled audit packs are mirrored to,
# at the same relative path ops/filer.py and ops/audit_pack.py build
# locally (Year/Month/Date/Transaction, and PortfolioCode/... respectively).
SHAREPOINT_OPS_FILED_FOLDER=Ops Filed Documents
SHAREPOINT_OPS_AUDIT_FOLDER=Ops Audit Repository
# Set to true to push both of the above to SharePoint (in addition to the
# local ops_output/ copies). Separate from SHAREPOINT_WRITE_BACK above so
# each use case's write-back can be turned on independently.
SHAREPOINT_OPS_WRITE_BACK=false


# --- Email intake connector (IMAP) (optional) --------------------------------
# Works with any standard IMAP mailbox (Office 365/Outlook, a hosted BIFM
# mailbox, Gmail-via-IMAP, etc). Leave IMAP_HOST blank to disable this source.
# If your provider requires an app-specific password for IMAP access
# (Gmail does when 2-Step Verification is on), use that instead of the
# normal account password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN
IMAP_PROCESSED_FOLDER=BIFM-Processed
# Only process a message once it's been sitting unread for at least this
# many minutes - avoids grabbing a submission before a client's follow-up
# attachment (sent moments later) has arrived.
IMAP_MIN_UNREAD_MINUTES=60
# Comma-separated allowlist of sender addresses permitted to submit
# instruction forms - mail from anyone else is left unread and ignored.
# Leave blank to accept every sender.
IMAP_ALLOWED_SENDERS=shyam.sp@kgisl.com


# --- OCR / rendering tuning ---------------------------------------------------
PDF_RENDER_DPI=220
OCR_ENHANCE_IMAGES=true
OCR_MIN_LONG_EDGE_PX=1600


# --- App-wide ----------------------------------------------------------------
BIFM_MAX_WORKERS=2
LOG_LEVEL=INFO
