# =============================================================================
# BIFM UT POC — environment configuration
# =============================================================================
# Copy this file to `.env` (already done for you if you're reading this from
# a freshly unzipped copy of the app — see .env in the project root) and
# fill in the keys for whichever OCR/LLM provider and connectors you're
# using. `.env` is loaded automatically on startup (config/settings.py) and
# is gitignored, so you only ever enter these once — no more re-exporting
# environment variables every session.
#
# Only fill in the section(s) you actually need:
#   - Exactly ONE of GROQ / GEMINI / OLLAMA, matching LLM_PROVIDER below.
#   - SharePoint and IMAP are both optional intake connectors — leave
#     either section blank to keep that source disabled in the UI.
# =============================================================================


# --- LLM Provider selection --------------------------------------------------
# Which vision/text LLM backend to use: "groq" (default, free, no card
# needed, cloud), "gemini" (free tier, cloud), or "ollama" (fully local,
# needs a GPU/enough RAM for an 8B vision model).
LLM_PROVIDER=groq


# --- Groq (recommended default) ----------------------------------------------
# Free, no-credit-card cloud API. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_REQUEST_TIMEOUT=60
GROQ_MAX_RETRIES=4
GROQ_NUM_PREDICT=800
# Self-throttle budget below Groq's real account TPM limit (check
# https://console.groq.com/settings/billing for your tier).
GROQ_TPM_LIMIT=27000


# --- Google Gemini (alternative) --------------------------------------------
# Free tier, cloud, no local hardware needed. Get a key at
# https://aistudio.google.com/apikey (Google account, no card required).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT=60
GEMINI_NUM_PREDICT=800


# --- Ollama (fully local/offline alternative) --------------------------------
# No API key needed — just a running local Ollama instance
# (`ollama serve`) with the models below pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
OLLAMA_REQUEST_TIMEOUT=600
OLLAMA_KEEP_ALIVE=60m
OLLAMA_NUM_PREDICT=800


# --- SharePoint intake/filing connector (optional) ---------------------------
# Microsoft Graph API app registration. Leave blank to disable this source.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_SUBMISSION_FOLDER=UT Instructions/Submissions
# Set to true to also push filed documents back to SharePoint (in addition
# to the local filing simulation).
SHAREPOINT_WRITE_BACK=false


# --- Email intake connector (IMAP) (optional) --------------------------------
# Works with any standard IMAP mailbox (Office 365/Outlook, a hosted BIFM
# mailbox, Gmail-via-IMAP, etc). Leave IMAP_HOST blank to disable this source.
# If your provider requires an app-specific password for IMAP access
# (Gmail does when 2-Step Verification is on), use that instead of the
# normal account password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN
IMAP_PROCESSED_FOLDER=BIFM-Processed


# --- OCR / rendering tuning ---------------------------------------------------
PDF_RENDER_DPI=220
OCR_ENHANCE_IMAGES=true
OCR_MIN_LONG_EDGE_PX=1600


# --- App-wide ----------------------------------------------------------------
BIFM_MAX_WORKERS=2
LOG_LEVEL=INFO
