      {"id": "payment_method", "section": "Banking Details", "label": "Payment Method", "mandatory": false, "source": "checkbox", "type": "enum", "options": ["Investor's bank account", "Third-Party"]},
      {"id": "bank_account_name", "section": "Banking Details", "label": "Bank Account Name", "mandatory": false, "source": "form_field", "type": "text"},
      {"id": "bank_name", "section": "Banking Details", "label": "Bank Name", "mandatory": false, "source": "form_field", "type": "text"},
      {"id": "account_number", "section": "Banking Details", "label": "Account Number", "mandatory": false, "source": "form_field", "type": "text"},
      {"id": "branch_name", "section": "Banking Details", "label": "Branch Name", "mandatory": false, "source": "form_field", "type": "text"},
      {"id": "branch_code", "section": "Banking Details", "label": "Branch Code", "mandatory": false, "source": "form_field", "type": "text"},
      {"id": "account_type_banking", "section": "Banking Details", "label": "Account Type", "mandatory": false, "source": "checkbox", "type": "enum", "options": ["Current", "Savings"]},
      {"id": "authorized_signatory_name", "section": "Authorisation", "label": "Authorized Signatory Name", "mandatory": false, "source": "form_field", "type": "text"},
      {"id": "date_signed", "section": "Authorisation", "label": "Date Signed", "mandatory": false, "source": "form_field", "type": "date"},
      {"id": "capacity", "section": "Authorisation", "label": "Capacity (Self / etc.)", "mandatory": false, "source": "form_field", "type": "text"}
    ]
  },
